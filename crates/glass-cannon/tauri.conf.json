{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Cannon",
  "identifier": "io.github.xinjalin.glass-cannon",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Glass Cannon",
        "url": "launcher.html",
        "width": 540,
        "height": 290,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "Glass Cannon settings",
        "width": 800,
        "height": 397,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "shadow": true,
        "maximizable": false,
        "url": "settings.html",
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "analysis",
        "title": "Glass Cannon analysis",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "shadow": true,
        "alwaysOnTop": true,
        "url": "analysis.html"
      },
      {
        "label": "history",
        "title": "Glass Cannon history",
        "width": 460,
        "height": 620,
        "minWidth": 320,
        "minHeight": 240,
        "url": "history.html",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "hud",
        "title": "Glass Cannon overlay",
        "url": "hud.html",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
