{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Cannon",
  "identifier": "io.github.xinjalin.glass-cannon",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glass Cannon",
        "width": 420,
        "height": 231,
        "minWidth": 280,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Glass Cannon settings",
        "width": 722,
        "height": 397,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "shadow": true,
        "maximizable": false,
        "url": "settings.html",
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
