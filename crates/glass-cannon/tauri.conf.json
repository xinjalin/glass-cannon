{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Cannon",
  "identifier": "io.github.xinjalin.glass-cannon",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glass Cannon",
        "width": 420,
        "height": 231,
        "minWidth": 280,
        "minHeight": 140,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Glass Cannon settings",
        "width": 800,
        "height": 397,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "shadow": true,
        "maximizable": false,
        "url": "settings.html",
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "analysis",
        "title": "Glass Cannon analysis",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": false,
        "visible": false,
        "shadow": true,
        "alwaysOnTop": true,
        "url": "analysis.html"
      },
      {
        "label": "history",
        "title": "Glass Cannon history",
        "width": 460,
        "height": 620,
        "minWidth": 320,
        "minHeight": 240,
        "url": "history.html",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "cooldowns",
        "title": "Glass Cannon cooldowns",
        "width": 300,
        "height": 360,
        "minWidth": 200,
        "minHeight": 120,
        "url": "cooldowns.html",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "timers",
        "title": "Glass Cannon timers",
        "width": 340,
        "height": 420,
        "minWidth": 260,
        "minHeight": 160,
        "url": "timers.html",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "target",
        "title": "Glass Cannon target",
        "width": 320,
        "height": 190,
        "minWidth": 220,
        "minHeight": 120,
        "url": "target.html",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      },
      {
        "label": "party-cooldowns",
        "title": "Glass Cannon party cooldowns",
        "width": 340,
        "height": 460,
        "minWidth": 240,
        "minHeight": 160,
        "url": "party-cooldowns.html",
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
