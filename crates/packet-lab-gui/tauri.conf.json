{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Packet Lab",
  "identifier": "io.github.xinjalin.packet-lab",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Packet Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
